{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evidiff.invalid/schemas/validation-tool-response.v0.2.json",
  "title": "MCP validate_review_result response envelope — proposal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "snapshot_id",
    "status",
    "provenance",
    "limitations",
    "result"
  ],
  "properties": {
    "schema_version": {
      "const": "0.2.0"
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "snapshot_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "SUCCESS",
        "ERROR"
      ]
    },
    "provenance": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source",
          "resource"
        ],
        "properties": {
          "source": {
            "type": "string",
            "minLength": 1
          },
          "resource": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "result": {
      "anyOf": [
        {
          "$ref": "https://evidiff.invalid/schemas/validated-review-receipt.v0.2.json"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "SUCCESS"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "result": {
            "$ref": "https://evidiff.invalid/schemas/validated-review-receipt.v0.2.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "ERROR"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "result": {
            "type": "null"
          }
        }
      }
    }
  ]
}
